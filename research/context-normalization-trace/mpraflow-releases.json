pi.github.com/users/visze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/visze/subscriptions","organizations_url":"https://api.github.com/users/visze/orgs","repos_url":"https://api.github.com/users/visze/repos","events_url":"https://api.github.com/users/visze/events{/privacy}","received_events_url":"https://api.github.com/users/visze/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"MDc6UmVsZWFzZTQ2Mzc0Njgx","tag_name":"v2.3.1","target_commitish":"master","name":"v2.3.1","draft":false,"immutable":false,"prerelease":true,"created_at":"2021-07-18T13:20:02Z","updated_at":"2021-07-18T13:21:08Z","published_at":"2021-07-18T13:21:08Z","assets":[],"tarball_url":"https://api.github.com/repos/shendurelab/MPRAflow/tarball/v2.3.1","zipball_url":"https://api.github.com/repos/shendurelab/MPRAflow/zipball/v2.3.1","body":"### association.nf\r\n\r\n* Bugfix empty design file (see issue #45)"},{"url":"https://api.github.com/repos/shendurelab/MPRAflow/releases/41181384","assets_url":"https://api.github.com/repos/shendurelab/MPRAflow/releases/41181384/assets","upload_url":"https://uploads.github.com/repos/shendurelab/MPRAflow/releases/41181384/assets{?name,label}","html_url":"https://github.com/shendurelab/MPRAflow/releases/tag/v2.3","id":41181384,"author":{"login":"visze","id":9267120,"node_id":"MDQ6VXNlcjkyNjcxMjA=","avatar_url":"https://avatars.githubusercontent.com/u/9267120?v=4","gravatar_id":"","url":"https://api.github.com/users/visze","html_url":"https://github.com/visze","followers_url":"https://api.github.com/users/visze/followers","following_url":"https://api.github.com/users/visze/following{/other_user}","gists_url":"https://api.github.com/users/visze/gists{/gist_id}","starred_url":"https://api.github.com/users/visze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/visze/subscriptions","organizations_url":"https://api.github.com/users/visze/orgs","repos_url":"https://api.github.com/users/visze/repos","events_url":"https://api.github.com/users/visze/events{/privacy}","received_events_url":"https://api.github.com/users/visze/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"MDc6UmVsZWFzZTQxMTgxMzg0","tag_name":"v2.3","target_commitish":"master","name":"v2.3","draft":false,"immutable":false,"prerelease":true,"created_at":"2021-04-09T12:39:49Z","updated_at":"2021-04-09T12:41:08Z","published_at":"2021-04-09T12:41:08Z","assets":[],"tarball_url":"https://api.github.com/repos/shendurelab/MPRAflow/tarball/v2.3","zipball_url":"https://api.github.com/repos/shendurelab/MPRAflow/zipball/v2.3","body":"### global changes\r\n\r\n* Correcting typos in documentation\r\n* adding new process label `highmem` to `conf/cluster.config`\r\n\r\n### association_saturationMutagenesis.nf\r\n\r\nNew association saturation mutagenesis workflow. This workflow is about assocation variant calls with barcodes. Variants are introduced by an error-prone PCR. The workflow takes the sequencing of the region, with barcodes in index read and the reference sequence and maps the reads to the reference, calls variants and associates them with the corresponding barcode. it is a pre-step of `saturationMutagenesis.nf`.\r\n\r\n### count.nf\r\n\r\n* using BC threshold input for `plot_perInsertCounts_correlation.R` instead of hard-coded. Modify process `calc_correlations` to use the new input theshold.\r\n\r\n### association.nf\r\n\r\n* Remove \"windows\" characters in design fasta"},{"url":"https://api.github.com/repos/shendurelab/MPRAflow/releases/28619829","assets_url":"https://api.github.com/repos/shendurelab/MPRAflow/releases/28619829/assets","upload_url":"https://uploads.github.com/repos/shendurelab/MPRAflow/releases/28619829/assets{?name,label}","html_url":"https://github.com/shendurelab/MPRAflow/releases/tag/v2.2","id":28619829,"author":{"login":"visze","id":9267120,"node_id":"MDQ6VXNlcjkyNjcxMjA=","avatar_url":"https://avatars.githubusercontent.com/u/9267120?v=4","gravatar_id":"","url":"https://api.github.com/users/visze","html_url":"https://github.com/visze","followers_url":"https://api.github.com/users/visze/followers","following_url":"https://api.github.com/users/visze/following{/other_user}","gists_url":"https://api.github.com/users/visze/gists{/gist_id}","starred_url":"https://api.github.com/users/visze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/visze/subscriptions","organizations_url":"https://api.github.com/users/visze/orgs","repos_url":"https://api.github.com/users/visze/repos","events_url":"https://api.github.com/users/visze/events{/privacy}","received_events_url":"https://api.github.com/users/visze/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"MDc6UmVsZWFzZTI4NjE5ODI5","tag_name":"v2.2","target_commitish":"master","name":"v2.2","draft":false,"immutable":false,"prerelease":true,"created_at":"2020-07-16T07:39:07Z","updated_at":"2020-07-16T07:52:47Z","published_at":"2020-07-16T07:52:47Z","assets":[],"tarball_url":"https://api.github.com/repos/shendurelab/MPRAflow/tarball/v2.2","zipball_url":"https://api.github.com/repos/shendurelab/MPRAflow/zipball/v2.2","body":"No workflow changes. Only a few fixes and some restructuring of configs. Using nextflow version 20.01 now!\r\n\r\n### global changes\r\n\r\n* nextflow version 20.01 is needed because of multiMap() function\r\n* introducing new config file `conf/global.config` with global variables like the min. required nextflow version and the actual MPRAflow version.\r\n* moving cluster config to a sepArate file: `conf/cluster.config`. Try to adapt the times to the sort and longtime labels. Modify SLURM queue to SLUM not SGE options.\r\n* improved documentation\r\n\r\n### saturationMutagenesis.nf\r\n\r\n* Bugfix of default out dir. It was not set to `params.outdir = \"outs\"` so it tries to create a folder `null`. Now in `params.outdir`\r\n* removing default `params.version` and `params.nf_required_version`. Now in `conf/global.config`\r\n* Catching cases when barcode/p-value filtering produces 0 variants\r\n* Change update depricated fork method. Now works with nextflow 20.01\r\n\r\n### count.nf\r\n\r\n* removing default `params.version`, `params.nf_required_version` and `params.outdir`. Now in `conf/global.config`.\r\n\r\n### association.nf\r\n\r\n* removing default `params.version`, `params.nf_required_version` and `params.outdir`. Now in `conf/global.config`."},{"url":"https://api.github.com/repos/shendurelab/MPRAflow/releases/25092839","assets_url":"https://api.github.com/repos/shendurelab/MPRAflow/releases/25092839/assets","upload_url":"https://uploads.github.com/repos/shendurelab/MPRAflow/releases/25092839/assets{?name,label}","html_url":"https://github.com/shendurelab/MPRAflow/releases/tag/v2.1","id":25092839,"author":{"login":"visze","id":9267120,"node_id":"MDQ6VXNlcjkyNjcxMjA=","avatar_url":"https://avatars.githubusercontent.com/u/9267120?v=4","gravatar_id":"","url":"https://api.github.com/users/visze","html_url":"https://github.com/visze","followers_url":"https://api.github.com/users/visze/followers","following_url":"https://api.github.com/users/visze/following{/other_user}","gists_url":"https://api.github.com/users/visze/gists{/gist_id}","starred_url":"https://api.github.com/users/visze/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/visze/subscriptions","organizations_url":"https://api.github.com/users/visze/orgs","repos_url":"https://api.github.com/users/visze/repos","events_url":"https://api.github.com/users/visze/events{/privacy}","received_events_url":"https://api.github.com/users/visze/received_events","type":"User","user_view_type":"public","site_admin":false},"node_id":"MDc6UmVsZWFzZTI1MDkyODM5","tag_name":"v2.1","target_commitish":"master","name":"v2.1","draft":false,"immutable":false,"prerelease":true,"created_at":"2020-07-16T07:48:43Z","updated_at":"2020-07-16T07:51:02Z","published_at":"2020-07-16T07:51:02Z","assets":[],"tarball_url":"https://api.github.com/repos/shendurelab/MPRAflow/tarball/v2.1","zipball_url":"https://api.github.com/repos/shendurelab/MPRAflow/zipball/v2.1","body":"Initial MPRAflow version for publication"}]