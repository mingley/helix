!Sample_library_selection = other
!Sample_library_source = genomic
!Sample_library_strategy = OTHER
!Sample_relation = BioSample: https://www.ncbi.nlm.nih.gov/biosample/SAMN13697084
!Sample_relation = SRA: https://www.ncbi.nlm.nih.gov/sra?term=SRX7474797
!Sample_supplementary_file_1 = NONE
