# Preserve the exact NCBI EFetch response, including its terminal blank line.
datasets/clinvar-hbb/reference.fasta whitespace=-blank-at-eof
datasets/hbb-reference/*.fasta whitespace=-blank-at-eof
datasets/hbb-reference/transcript.gb whitespace=-trailing-space
datasets/hbb-reference/annotation.json whitespace=-trailing-space
# Preserve the exact source CSV's CRLF bytes.
datasets/hbb-promoter-assay/scores.csv -text whitespace=cr-at-eol
datasets/regulatory-cohort/*.scores.csv -text whitespace=cr-at-eol
datasets/regulatory-cohort/reference-*.json -text whitespace=-trailing-space
datasets/regulatory-motifs/jaspar-about.html -text -whitespace
# Retained upstream material is evidence, including its original whitespace.
research/forensic-sources/author-* -text -whitespace
research/forensic-sources/*.xml -text -whitespace
research/forensic-sources/*.html -text -whitespace
research/forensic-sources/*.soft -text -whitespace
# Preserve the hashed Matplotlib/CSV output exactly as generated.
research/results/regulatory-v1/figures/*.svg -text whitespace=-trailing-space
research/results/regulatory-v1/figures/*.csv -text whitespace=cr-at-eol
